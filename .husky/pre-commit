#!/usr/bin/env sh

# Guard: the umami analytics script in index.html must be committed uncommented.
# (It only reports on the production domains via `data-domains`, so local dev is
# unaffected either way — this just prevents accidentally shipping it disabled.)
if git show :index.html 2>/dev/null | grep -qE '<!--[^>]*cloud\.umami\.is/script\.js'; then
  echo "✖ index.html: the umami analytics script is commented out."
  echo "  Uncomment it before committing (local dev is unaffected by data-domains)."
  exit 1
fi

npx lint-staged